# ============================================================
# 投标文档 RAG 系统 — 环境变量配置
# 复制此文件为 .env 并修改实际值
# ============================================================

# === LLM 配置 ===
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-deepseek-api-key
LLM_API_BASE=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.1

# === Embedding 配置 (Xinference) ===
EMBEDDING_API_BASE=http://localhost:9997/v1
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIM=1024

# === Milvus 配置 ===
MILVUS_HOST=localhost
MILVUS_PORT=19530

# === PostgreSQL 配置 ===
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ai_bid_rag
PG_USER=postgres
PG_PASSWORD=postgres

# === MinIO 配置 ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bid-documents
MINIO_SECURE=false

# === 文档处理配置 ===
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.6
RETRIEVAL_RERANK_THRESHOLD=0.8

# === Query 改写 ===
QUERY_REWRITE_ENABLED=false        # 检索页服务端默认开关（请求未显式传 query_rewrite 时生效；默认关）
CHAT_QUERY_REWRITE_ENABLED=false   # 问答（chat）Query 改写开关（无前端控件；默认关）
CHAT_INTENT_DETECT_ENABLED=true    # 问答（chat）意图识别开关（普通聊天不走检索；默认开）

# === 服务配置 ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
TEMP_DIR=./temp
MAX_UPLOAD_SIZE=524288000

# === Langfuse 观测配置 ===
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://your-langfuse-host
LANGFUSE_SAMPLE_RATE=1.0

# === Neo4j 图谱配置 ===
GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# === Elasticsearch full-text ===
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=
ES_PASSWORD=
# v2 uses its own index to isolate from v1 (e.g. bid_chunks_v2); default is bid_chunks
ES_INDEX_NAME=bid_chunks
